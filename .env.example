# Copy this file to .env and set a database password.
# `./scripts/setup.sh` does this for you.
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Optional: host port used to reach the app container.
APP_PORT=3000

# Optional local development overrides:
# DB_PORT=5439
# DATABASE_URL=postgres://modulate:replace-with-a-long-random-password@localhost:5439/modulate

# Optional: match the container user to your host user for bind mounts.
# PUID=1000
# PGID=1000

# Optional: host folder for an existing read-only music library.
# MUSIC_DIR=./music
