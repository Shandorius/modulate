# Production Compose only needs the database password.
# The app generates its session secret into /data on first start.
POSTGRES_PASSWORD=replace-with-a-long-random-password
APP_PORT=3000

# Set this to your published image.
MODULATE_IMAGE=ghcr.io/your-github-user/modulate:latest

# Optional: match the container user to your host user for bind mounts.
# PUID=1000
# PGID=1000
